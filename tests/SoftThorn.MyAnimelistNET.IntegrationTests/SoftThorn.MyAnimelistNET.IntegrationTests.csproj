<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<IsPackable>false</IsPackable>
		<UserSecretsId>cc5b08ee-4b6b-4874-bfba-75c8768beed0</UserSecretsId>
		<!-- two solution files sit next to this project; tell Verify which one to use -->
		<SolutionDir Condition="'$(SolutionDir)' == '' or '$(SolutionDir)' == '*Undefined*'">$(MSBuildThisFileDirectory)..\..\</SolutionDir>
		<SolutionName Condition="'$(SolutionName)' == '' or '$(SolutionName)' == '*Undefined*'">SoftThorn.MyAnimelistNET</SolutionName>
		<!-- Verify's Open Source Maintenance Fee: this project is open source and generates no revenue. Renew before it expires (max 12 months ahead). -->
		<Verify_SponsorshipExemption>OpenSource</Verify_SponsorshipExemption>
		<Verify_SponsorshipExemptionUntil>2027-10</Verify_SponsorshipExemptionUntil>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.Playwright.Xunit.v3" />
		<PackageReference Include="Microsoft.Extensions.Configuration.UserSecrets" />
		<PackageReference Include="Microsoft.Extensions.DependencyInjection" />
		<PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" />
		<PackageReference Include="Microsoft.NET.Test.Sdk" />
		<PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" />
		<PackageReference Include="Verify.XunitV3" />
		<PackageReference Include="xunit.v3.mtp-v2" />
		<PackageReference Include="xunit.runner.visualstudio">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
	</ItemGroup>

	<ItemGroup>
	  <ProjectReference Include="..\..\src\SoftThorn.MyAnimelistNET.csproj" />
	</ItemGroup>

	<ItemGroup>
		<Using Include="SoftThorn.MyAnimelistNET" />
		<Using Include="Xunit" />
	</ItemGroup>

</Project>
